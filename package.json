{
  "name": "lingjing-v4",
  "version": "1.11.0",
  "description": "灵境制造 V4 - AI驱动的3D建模与工艺规划系统",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/**/*.{ts,vue} --fix",
    "format": "prettier src/**/*.{ts,vue,css} --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.10.1",
    "axios": "^1.6.2",
    "echarts": "^5.5.0",
    "element-plus": "^2.4.4",
    "markdown-it": "^14.0.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "three": "^0.170.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "happy-dom": "^12.10.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sass": "^1.69.5",
    "terser": "^5.46.2",
    "typescript": "^5.3.2",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.0.0",
    "vitest": "^1.0.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ],
    "python/**/*.py": [
      "black",
      "ruff check --fix"
    ],
    "src-tauri/**/*.rs": [
      "cargo fmt --"
    ]
  }
}
