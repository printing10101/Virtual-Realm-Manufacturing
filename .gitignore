# ============================================================
# 大型数据文件（由 Git LFS 管理，不要直接提交）
# 配合 Git LFS 迁移计划（缺陷#5），确保大文件通过 LFS 跟踪
# ============================================================
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pkl
*.bin
# .gitattributes 必须保持跟踪，不得忽略
!.gitattributes

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
*.pyc

