# ============================================================
# 大型数据文件（由 Git LFS 管理，不要直接提交）
# 配合 Git LFS 迁移计划（缺陷#5），确保大文件通过 LFS 跟踪
# ============================================================
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pkl
*.bin
# .gitattributes 必须保持跟踪，不得忽略
!.gitattributes

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
*.pyc

# ============================================================
# Node.js
# ============================================================
node_modules/
dist/
build/
.vite/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ============================================================
# Rust / Tauri
# ============================================================
src-tauri/target/
**/target/
**/*.rs.bk
*.pdb
Cargo.lock.lock

# ============================================================
# 测试和报告
# ============================================================
pytest_cache/
.pytest_cache/
.coverage
.coverage.*
noxfile.py
htmlcov/
.hypothesis/
test-results/
playwright-report/
coverage/
coverage-reports/
benchmarks/results/
benchmarks/performance/history/

# 测试生成的临时目录
python/test_chroma_db/
python/test_chroma_db_e2e/
python/tests/_test_output/
python/_test_output/
python/_test_output*.txt

# 运行时生成的输出目录（模型/项目/规则/仿真/演示等）
python/output/
output/
!output/.gitkeep

# 测试追踪与日志
test_traces/

# ============================================================
# 日志
# ============================================================
logs/
*.log
test_logs/

# ============================================================
# 环境和配置（敏感信息，禁止提交）
# ============================================================
# 忽略所有 .env 文件（含实际密码/密钥），仅保留 .env.example 模板
.env
.env.*
!.env.example
!.env.sqlite.example
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# Docker / Compose 相关的本地环境文件
docker.env
compose.env

# 凭据与密钥文件
*.pem
*.key
*.crt
secrets/


# 认证令牌文件（每个部署环境独立生成）
.lnn_token
.lnn_token_meta.json

# ============================================================
# 虚拟环境
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# 数据库文件（如包含敏感数据）
# ============================================================
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ============================================================
# 系统文件
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================================================
# 临时文件
# ============================================================
*.tmp
*.temp
*.bak
*.bak.*
*.orig

# ============================================================
# 临时调试/诊断脚本（项目根目录）
