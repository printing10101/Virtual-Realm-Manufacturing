[flake8]
max-line-length = 120
extend-ignore =
    E203,
    W503,
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    # 排除临时一次性验证脚本（以单下划线开头的工具脚本）
    _*.py,
    # 排除 Agent Review 临时 diff 快照目录
    C:/Users/Lenovo/AppData/Local/Temp/trae-cn/agent-review/*,
per-file-ignores =
    python/app/ai/lnn/engine.py:E203
    python/app/ai/lnn/quantization/quantizer.py:E203
    python/app/cad/cadquery_gen.py:E203
    python/app/audit/audit_log.py:E203
    python/alembic/versions/be7e8d82d196_initial_schema.py:E122,E128,E501,W291
