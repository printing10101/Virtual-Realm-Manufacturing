# ============================================================
# 灵境制造 - SQLite 单机部署环境变量模板
# ============================================================
# 用途：配合 docker-compose-sqlite.yml 使用
# 使用方法：cp .env.sqlite.example .env.sqlite
#          docker compose -f docker-compose-sqlite.yml --env-file .env.sqlite up -d
# ============================================================

# 运行环境
APP_ENV=production
PORT=8765

# AI 模型配置（local=本地 Ollama，cloud=云端 API，hybrid=混合）
AI_MODE=local

# 本地 Ollama 配置
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# 云端 API 配置（AI_MODE=cloud 或 hybrid 时需要）
CLOUD_API_KEY=
CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_MODEL=qwen-plus

# JWT 密钥（生产环境务必修改为随机长字符串）
# 注意：项目实际读取的变量名为 LNN_JWT_SECRET，未设置时应用拒绝启动
LNN_JWT_SECRET=change-me-to-a-random-secret-in-production

# CORS 允许的源
CORS_ORIGINS=http://localhost:1420,http://localhost:8765
