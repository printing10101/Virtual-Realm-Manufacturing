# ==================================
# 灵境制造 - 环境变量配置示例
# ==================================
# 复制此文件为 .env 并根据实际情况修改配置值
# 注意: 不要将 .env 文件提交到版本控制系统

# ==================================
# 应用基础配置
# ==================================
APP_NAME=灵境制造
APP_VERSION=4.0.0
OFFLINE_MODE=false

# ==================================
# 服务器配置
# ==================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
DEBUG=false

# ==================================
# AI 配置
# ==================================
# AI模式: local(本地Ollama) | cloud(云端API) | rule(规则引擎)
AI_MODE=local

# 本地Ollama配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# 云端API配置
CLOUD_API_KEY=your-api-key-here
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-3.5-turbo

# AI请求参数
AI_TIMEOUT=60
AI_MAX_RETRIES=3

# ==================================
# 存储配置
# ==================================
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ==================================
# 数据库配置
# ==================================
CAD_DB_PATH=./cad_tasks.db
MODEL_LIBRARY_PATH=./model_library.db

# ==================================
# 安全配置
# ==================================
# CORS允许的源(逗号分隔,*表示允许所有)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# 速率限制
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
