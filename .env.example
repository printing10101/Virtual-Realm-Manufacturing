# ============================================================
# 灵境制造（上线版）环境变量模板
# ============================================================
# 使用说明：
#   1. 复制本文件为 .env  ：  cp .env.example .env  (Linux/Mac)
#                           或 copy .env.example .env (Windows)
#   2. 在 .env 中为下列带占位符的变量填入真实值（密码建议使用密码管理器生成的高强度随机串）
#   3. .env 文件已被 .gitignore 忽略，请勿提交到 Git 仓库
#
# 安全要求：
#   - POSTGRES_PASSWORD   至少 16 位，包含大小写字母、数字、特殊字符
#   - GF_SECURITY_ADMIN_PASSWORD  至少 12 位，首次启动后请立即修改
#   - REDIS_PASSWORD      必填（docker-compose 已强制启用 requirepass），至少 16 位
#   - DB_URL 中的密码需与 POSTGRES_PASSWORD 保持一致
#   - REDIS_URL 中的密码需与 REDIS_PASSWORD 保持一致
# ============================================================

# -------------------- 应用通用配置 --------------------
# 运行环境：development | staging | production
APP_ENV=production

# API 服务端口（容器内）
PORT=8765

# -------------------- PostgreSQL 数据库 --------------------
# 数据库用户名
POSTGRES_USER=lnn

# 数据库密码（必填，修改此处后请同步修改下方 DB_URL 中的密码段）
POSTGRES_PASSWORD=

# 数据库名称
POSTGRES_DB=lnn_db

# 应用连接数据库的完整 URL（密码段必须与 POSTGRES_PASSWORD 一致）
# 格式：postgresql://<user>:<password>@<host>:<port>/<dbname>
DB_URL=postgresql://lnn:CHANGE_ME@postgres:5432/lnn_db

# -------------------- Redis 缓存 --------------------
# Redis 访问密码（必填，docker-compose 已强制启用 requirepass；至少 16 位强密码）
REDIS_PASSWORD=

# 应用连接 Redis 的 URL（密码段必须与 REDIS_PASSWORD 一致）
# 格式：redis://:your_password@redis:6379/0
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# -------------------- Grafana 监控 --------------------
# Grafana 管理员密码（首次登录后请立即修改；至少 12 位）
GF_SECURITY_ADMIN_PASSWORD=

# Grafana 管理员用户名
GF_SECURITY_ADMIN_USER=admin

# -------------------- TDengine 时序数据库 --------------------
# 应用连接 TDengine 的 URL（使用 native 协议，端口 6030）
# 容器内推荐格式：taos://root:<your_password>@tdengine:6030
# 本地开发格式：  taos://root:<your_password>@localhost:6030
# 注意：密码段必须与上方 TDENGINE_PASSWORD 保持一致
TDENGINE_URL=taos://root:CHANGE_ME@tdengine:6030

# TDengine 数据库名（不存在时自动创建）
TDENGINE_DB=lnn_tsdb

# TDengine 用户名
TDENGINE_USER=root

# TDengine 密码（必填，请勿使用默认值）
TDENGINE_PASSWORD=

# TDengine 连接超时（秒）
TDENGINE_CONNECT_TIMEOUT=10

# TDengine 健康检查端点（容器内为 taos 服务的 REST API）
TDENGINE_HEALTH_URL=http://tdengine:6041/api/health

# -------------------- 认证与安全 --------------------
# JWT 密钥（必填，至少 32 字符，使用以下命令生成）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
LNN_JWT_SECRET=

# -------------------- 云服务 API --------------------
# 云端 LLM API Key（使用云服务时必填）
CLOUD_API_KEY=

# 云端 LLM Base URL
CLOUD_BASE_URL=https://api.openai.com/v1

# 云端 LLM 模型名称
CLOUD_MODEL=gpt-3.5-turbo

# -------------------- 镜像与模型配置 --------------------
# HuggingFace 镜像站（用于加速模型下载，默认使用中国镜像）
# 可选值：https://hf-mirror.com (中国) | https://huggingface.co (官方)
HF_ENDPOINT=https://hf-mirror.com

# Ollama 离线模型路径（可选）
# 如果设置，将优先从该路径加载模型，适用于无法访问外网的环境
# 可从 https://modelscope.cn 或 https://hf-mirror.com 手动下载模型
OLLAMA_MODEL_PATH=

# -----------------------------------------------------------------------------
# MES/ERP 系统集成配置（可选）
# -----------------------------------------------------------------------------
# 启用 MES 集成
MES_ENABLED=false

# MES 系统基础 URL
# MES_BASE_URL=https://mes.example.com

# MES API 认证密钥
# MES_API_KEY=your-mes-api-key

# MES 请求超时时间（秒）
MES_TIMEOUT=30.0

# -----------------------------------------------------------------------------
# 服务器配置
# -----------------------------------------------------------------------------
# 服务器绑定地址（默认 127.0.0.1，生产环境可能需要改为 0.0.0.0）
SERVER_HOST=127.0.0.1

# 服务器端口（默认 8765）
SERVER_PORT=8765

# 调试模式（生产环境必须为 false）
DEBUG=false

# -----------------------------------------------------------------------------
# AI 配置
# -----------------------------------------------------------------------------
# AI 模式：local | cloud | hybrid
AI_MODE=local

# Ollama 本地模型服务地址
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 默认模型
OLLAMA_MODEL=qwen2.5-coder:7b

# 本地模型名称（备用）
LOCAL_MODEL=qwen2.5:7b

# 云端 AI 提供商：openai | azure | anthropic
CLOUD_PROVIDER=openai

# 云端模型路由（用于复杂任务）
CLOUD_MODEL_ROUTER=gpt-4o

# AI 请求超时时间（秒）
AI_TIMEOUT=60

# AI 最大重试次数
AI_MAX_RETRIES=3

# 本地模型超时时间（秒）
LOCAL_TIMEOUT=30

# 回退阈值（本地模型置信度低于此值时切换到云端）
FALLBACK_THRESHOLD=3

# 微调自动触发（是否自动触发模型微调）
FINETUNE_AUTO_TRIGGER=false

# 微调最小样本数
FINETUNE_MIN_SAMPLES=50

# 微调间隔天数
FINETUNE_INTERVAL_DAYS=7

# -----------------------------------------------------------------------------
# 仿真配置
# -----------------------------------------------------------------------------
# 体素尺寸（毫米）
LNN_SIM_VOXEL_SIZE=1.0

# 最大仿真存储数量
LNN_SIM_MAX_STORE=500

# 仿真存储过期时间（秒，默认 24 小时）
LNN_SIM_STORE_AGE=86400

# 碰撞检测边距（毫米）
LNN_SIM_COLLISION_MARGIN=0.5

# 批量处理大小
LNN_SIM_BATCH_SIZE=2000

# 安全 Z 高度（毫米）
LNN_SIM_SAFE_Z=10.0

# 空闲超时时间（秒，默认 30 分钟）
LNN_IDLE_TIMEOUT=1800

# -----------------------------------------------------------------------------
# CORS 跨域配置
# -----------------------------------------------------------------------------
# 允许的源（逗号分隔，如 http://localhost:3000,https://app.example.com）
CORS_ORIGINS=

# 是否允许凭证（cookies, authorization headers）
CORS_ALLOW_CREDENTIALS=true

# 允许的正则表达式源（可选）
CORS_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# 速率限制
# -----------------------------------------------------------------------------
# 是否启用速率限制
RATE_LIMIT_ENABLED=true

# 每个窗口最大请求数
RATE_LIMIT_REQUESTS=100

# 时间窗口（秒）
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# 认证与权限
# -----------------------------------------------------------------------------
# 是否启用 LNN 认证
LNN_AUTH_ENABLED=true

# 是否强制执行权限检查
LNN_PERMISSION_ENFORCED=true

# 是否启用 Agent 认证
AGENT_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# 环境配置
# -----------------------------------------------------------------------------
# 运行环境：development | staging | production | testing
ENVIRONMENT=development

# 应用名称
APP_NAME=灵境制造

# 应用版本
APP_VERSION=2.3.0

# 离线模式（禁用所有外部网络请求）
OFFLINE_MODE=false

# -----------------------------------------------------------------------------
# 路径配置
# -----------------------------------------------------------------------------
# 备份目录
BACKUP_DIR=./backups

# SQLite 数据库路径
DB_PATH=./data/app.db

# 向量数据库路径
VECTOR_DB_PATH=./data/chroma_db

# 配置文件路径
CONFIG_PATH=./config.json

# GStack 目录
LNN_GSTACK_DIR=.lingjing/.gstack

# -----------------------------------------------------------------------------
# 任务系统配置
# -----------------------------------------------------------------------------
# 最大并发任务数
TASK_MAX_CONCURRENT=3

# 任务恢复策略：mark_failed | retry | ignore
TASK_RECOVERY_STRATEGY=mark_failed

# 最大任务历史记录数
TASK_MAX_HISTORY=10000

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LNN_LOG_LEVEL=INFO

# 日志格式
LNN_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志文件最大大小（字节，默认 50MB）
LNN_LOG_MAX_BYTES=52428800

# 日志备份数量
LNN_LOG_BACKUP_COUNT=5

# 日志保留天数
LNN_LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 工艺规划阈值
# -----------------------------------------------------------------------------
# 默认粗糙度参数
LNN_PP_RA_DEFAULT=3.2

# 最小平面面积（mm²）
LNN_PP_MIN_PLANE_AREA=1.0

# 最小型腔尺寸（mm）
LNN_PP_MIN_CAVITY_DIM=0.5

# 最小凸台直径（mm）
LNN_PP_MIN_BOSS_DIAM=1.0

# 最小孔径（mm）
LNN_PP_MIN_HOLE_DIAM=0.5

# 钻头角度（度）
LNN_PP_DRILL_ANGLE=118.0

# GCode 程序号起始值
LNN_PP_GCODE_PROG_NUM=1000

# -----------------------------------------------------------------------------
# DNC 机床通信配置（可选）
# -----------------------------------------------------------------------------
# DNC 功能已内置，通过 API 动态配置机床连接
# 使用 /api/v1/dnc/machines 接口添加机床
# 支持 OPC UA 和 MTConnect 两种协议
