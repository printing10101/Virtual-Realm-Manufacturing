# Application Settings
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Server
PORT=8000
HOST=0.0.0.0
WORKERS=4

# Database
DB_URL=postgresql://lnn:lnn_password@localhost:5432/lnn_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LNN Models
LNN_MODELS_DIR=models/lnn
LNN_DEFAULT_DEVICE=cpu
LNN_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=false
LOG_LEVEL=info
